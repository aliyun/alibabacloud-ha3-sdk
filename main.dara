/**
 * 获取表列表
 */
async function listTables(): ListTablesResponse {
  return _openApiRequest('GET', `/openapi/ha3/instances/${@instanceId}/tables`, null, null, null, @runtimeOptions);
}

/**
 * 获取表详情
 */
async function getTable(tableName: string): GetTableResponse {
  return _openApiRequest('GET', `/openapi/ha3/instances/${@instanceId}/tables/${tableName}`, null, null, null, @runtimeOptions);
}

/**
 * 创建表
 */
async function createTable(request: CreateTableRequest): CreateTableResponse {
  var query : map[string]any = {};
  if (!Util.isUnset(request.dryRun)) {
    query['dryRun'] = request.dryRun;
  }
  return _openApiRequest('POST', `/openapi/ha3/instances/${@instanceId}/tables`, query, null, Util.toJSONString(request), @runtimeOptions);
}

/**
 * 修改表
 */
async function modifyTable(tableName: string, request: ModifyTableRequest): ModifyTableResponse {
  var query : map[string]any = {};
  if (!Util.isUnset(request.dryRun)) {
    query['dryRun'] = request.dryRun;
  }
  return _openApiRequest('PUT', `/openapi/ha3/instances/${@instanceId}/tables/${tableName}`, query, null, Util.toJSONString(request), @runtimeOptions);
}

/**
 * 删除表
 */
async function deleteTable(tableName: string): DeleteTableResponse {
  return _openApiRequest('DELETE', `/openapi/ha3/instances/${@instanceId}/tables/${tableName}`, null, null, null, @runtimeOptions);
}

/**
 * 表停止使用
 */
async function stopTable(tableName: string): StopTableResponse {
  return _openApiRequest('POST', `/openapi/ha3/instances/${@instanceId}/indexes/${tableName}/stopIndex`, null, null, null, @runtimeOptions);
}

/**
 * 表恢复使用
 */
async function startTable(tableName: string): StartTableResponse {
  return _openApiRequest('POST', `/openapi/ha3/instances/${@instanceId}/indexes/${tableName}/startIndex`, null, null, null, @runtimeOptions);
}

/**
 * 索引重建
 */
async function reindex(tableName: string, request: ReindexRequest): ReindexResponse {
  return _openApiRequest('POST', `/openapi/ha3/instances/${@instanceId}/tables/${tableName}/reindex`, null, null, Util.toJSONString(request), @runtimeOptions);
}

/**
 * 获取索引版本列表
 */
async function listTableGenerations(tableName: string): ListTableGenerationsResponse {
  return _openApiRequest('GET', `/openapi/ha3/instances/${@instanceId}/tables/${tableName}/index_versions`, null, null, null, @runtimeOptions);
}

/**
 * 获取索引版本详情
 */
async function getTableGeneration(tableName: string, generationId: string): GetTableGenerationResponse {
  return _openApiRequest('GET', `/openapi/ha3/instances/${@instanceId}/tables/${tableName}/index_versions/${generationId}`, null, null, null, @runtimeOptions);
}

/**
 * 获取任务列表
 */
async function listTasks(request: ListTasksRequest): ListTasksResponse {
  var query : map[string]any = {};
  var one = Number.parseLong("1000");

  if (!Util.isUnset(request.end)) {
    query['end'] = Number.mul(request.end, one);
  }

  if (!Util.isUnset(request.start)) {
    query['start'] = Number.mul(request.start, one);
  } else {
    var now = Number.parseLong(Time.unix());
    var period = Number.parseLong("86400");
    query['start'] = Number.mul(Number.sub(now, period), one);
  }

  return _openApiRequest('GET', `/openapi/ha3/instances/${@instanceId}/tasks`, query, null, null, @runtimeOptions);
}
